# Server only. Do not prefix secrets with VITE_ or commit a real .env file.
UPSTREAM_API_URL=https://api.transitous.org/api/v6/plan
UPSTREAM_GEOCODE_URL=https://api.transitous.org/api/v1/geocode
# Leave empty for Transitous. Set these only if a future provider requires a key.
UPSTREAM_API_KEY=
UPSTREAM_API_KEY_HEADER=x-api-key
# Public URL where the API provider can contact the application maintainer.
APP_CONTACT_URL=https://github.com/jiho051225/exchange_map
# Production server settings
HOST=127.0.0.1
PORT=4173
